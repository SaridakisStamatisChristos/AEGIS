# Alertmanager webhook receiver endpoints
# Copy to an environment file (for example: ops/prometheus/alertmanager.env)
# and set real paging/incident webhook URLs per environment.

ALERTMANAGER_WEBHOOK_PRIMARY_URL=https://alerts.example.com/oncall-primary
ALERTMANAGER_WEBHOOK_SECONDARY_URL=https://alerts.example.com/oncall-secondary
ALERTMANAGER_WEBHOOK_ESCALATION_URL=https://alerts.example.com/oncall-escalation
