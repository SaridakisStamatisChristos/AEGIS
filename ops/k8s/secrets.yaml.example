# EXAMPLE ONLY - DO NOT COMMIT WITH REAL VALUES
# Copy to secrets.yaml and populate with real secrets
apiVersion: v1
kind: Secret
metadata:
  name: aegisrun-secrets
  namespace: aegisrun
  labels:
    app.kubernetes.io/name: aegisrun
type: Opaque
stringData:
  # Database credentials
  DB_USER: "aegisrun"
  DB_PASSWORD: "<CHANGE_ME>"
  
  # OIDC configuration
  OIDC_ISSUER: "https://auth.example.com"
  OIDC_CLIENT_ID: "aegisrun"
  OIDC_CLIENT_SECRET: "<CHANGE_ME>"
  
  # JWT signing
  JWT_SECRET: "<GENERATE_WITH_openssl_rand_hex_32>"
