# AegisRun Environment Configuration
# Copy this file to .env and update values
#
# !! SECURITY WARNING !!
# Default values are for LOCAL DEVELOPMENT ONLY.
# For staging/production, set APP_ENV=production and override ALL
# credentials, OIDC settings, CORS origins, and DB passwords.
# The server will refuse to start in production mode with insecure defaults.

# =============================================================================
# Application Environment
# =============================================================================
# Set to "production" to enable strict config validation (fatal on missing settings)
APP_ENV=development

# =============================================================================
# Database Configuration
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=aegisrun
DB_PASSWORD=aegisrun
DB_NAME=aegisrun
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# =============================================================================
# API Server Configuration
# =============================================================================
PORT=8080
LOG_LEVEL=info
LOG_FORMAT=json

# =============================================================================
# Authentication (OIDC)
# =============================================================================
# Set to "mock" for local development.
# In production, OIDC_ISSUER must be a real provider URL (e.g. https://auth.example.com).
# The server WILL NOT start in production mode with OIDC_ISSUER=mock.
OIDC_ISSUER=mock
OIDC_CLIENT_ID=aegisrun
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:8080/auth/callback

# Audience for token validation (defaults to OIDC_CLIENT_ID if empty)
OIDC_AUDIENCE=

# Maximum token age in seconds (rejects tokens issued longer ago than this)
MAX_TOKEN_AGE_SECONDS=3600

# =============================================================================
# Security
# =============================================================================
# CORS allowed origin
CORS_ALLOW_ORIGIN=http://localhost:5173

# JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-in-production

# =============================================================================
# Feature Flags
# =============================================================================
# Enable/disable features
ENABLE_METRICS=true
ENABLE_TRACING=false
ENABLE_REPLAY=true

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# =============================================================================
# Evidence & Signing
# =============================================================================
# Key rotation interval
KEY_ROTATION_DAYS=90

# Bundle export settings
BUNDLE_MAX_SIZE_MB=100

# =============================================================================
# Observability
# =============================================================================
# Prometheus metrics endpoint
METRICS_PORT=9090

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=aegisrun-api

# =============================================================================
# UI Configuration
# =============================================================================
VITE_API_URL=http://localhost:8080
VITE_APP_NAME=AegisRun
